# `cp .env.example .env` 再填。值不准寫進這份檔。
# 沒有 `.env` 就 `docker compose up` → Docker 會建一個叫 `.env` 的資料夾。
# 值不要加引號、不要 export。
# DATABASE_URL／OLLAMA_BASE_URL／CELERY_BROKER_URL 由 compose 覆寫，容器裡改無效。

# 本機 DB：埠 5433、帳號 postgres
DATABASE_URL=
OLLAMA_BASE_URL=
VLM_MODEL=
LLM_MODEL=
EMBEDDING_MODEL=

# OLLAMA_API_KEY 空＝切不了雲端。雲端模型名不要抄本機 MLX 標籤。
OLLAMA_API_KEY=
OLLAMA_CLOUD_VLM_MODEL=
OLLAMA_CLOUD_LLM_MODEL=

# 程式用 personaldocai-mac，不是 CLI admin
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
SQS_JOBS_QUEUE_URL=
SQS_RESULTS_QUEUE_URL=

# CLOUD_ROUTE = off | assume | ec2。EC2_WORKER_INSTANCE_ID 空＝探測當不可用。
CLOUD_ROUTE=
CLOUD_RESULT_TIMEOUT_SECONDS=
EC2_WORKER_INSTANCE_ID=
